/* Global dark theme for SmartLamp */
page {
  --bg: #0f0f1a;
  --bg-card: #1a1a2e;
  --bg-card-hover: #252540;
  --text: #e8e8f0;
  --text-dim: #7a7a95;
  --text-muted: #555570;
  --primary: #6c63ff;
  --primary-glow: rgba(108,99,255,0.3);
  --primary-light: #2a2550;
  --danger: #ff6b6b;
  --success: #4ecdc4;
  --warn: #ffd166;
  --white: #ffffff;
  --on-color: #333350;
  --hover-bg: #252540;
  --error-bg: #3d1f1f;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
}
