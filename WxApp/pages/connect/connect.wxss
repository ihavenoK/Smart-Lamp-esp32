/* pages/connect/connect.wxss */

.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 36rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== header ===== */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}
.lamp-icon-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--primary-light);
  margin-bottom: 32rpx;
  box-shadow: 0 0 60rpx var(--primary-glow);
}
.lamp-icon-img.pulse {
  animation: iconPulse 1.5s ease-in-out infinite;
}
@keyframes iconPulse {
  0%, 100% { box-shadow: 0 0 40rpx var(--primary-glow); }
  50%      { box-shadow: 0 0 80rpx rgba(108,99,255,0.6); }
}
.title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 2rpx;
}
.subtitle {
  font-size: 26rpx;
  color: var(--text-dim);
  margin-top: 10rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

/* ===== scan button ===== */
.scan-btn {
  position: relative;
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--primary);
  color: var(--white);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  overflow: hidden;
  margin-bottom: 40rpx;
}
.scan-btn.scanning {
  opacity: 0.85;
}
.scan-btn-press {
  transform: scale(0.97);
}
.scan-btn-text {
  position: relative;
  z-index: 1;
}
.scan-ring {
  position: absolute;
  top: -10rpx; left: -10rpx; right: -10rpx; bottom: -10rpx;
  border-radius: 60rpx;
  border: 3rpx solid rgba(108,99,255,0.4);
  animation: ringOut 1.2s ease-out infinite;
}
@keyframes ringOut {
  0%   { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.15); opacity: 0; }
}

/* ===== device list ===== */
.list {
  width: 100%;
}
.list-title {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.device-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}
.device-card.connecting {
  opacity: 0.5;
}
.device-card-press {
  background: var(--bg-card-hover);
}
.dev-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.dev-icon {
  font-size: 40rpx;
  width: 60rpx;
  text-align: center;
}
.dev-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.dev-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}
.dev-id {
  font-size: 20rpx;
  color: var(--text-muted);
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dev-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
/* signal bars */
.signal {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 28rpx;
}
.signal-bar {
  width: 6rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: var(--on-color);
  transition: background 0.3s;
}
.signal-bar.on {
  background: var(--success);
}
.dev-arrow {
  font-size: 28rpx;
  color: var(--primary);
}

/* ===== empty ===== */
.empty {
  text-align: center;
  margin-top: 80rpx;
}
.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 32rpx;
  color: var(--text-dim);
  display: block;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ===== error ===== */
.error-toast {
  width: 100%;
  background: var(--error-bg);
  border-radius: var(--radius);
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: var(--danger);
  margin-top: 20rpx;
  border: 1rpx solid rgba(255,107,107,0.2);
}
