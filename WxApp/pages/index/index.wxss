/* pages/index/index.wxss */

.page {
  padding: 20rpx 28rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== top bar ===== */
.topbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}
.conn-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 12rpx rgba(78,205,196,0.5);
  animation: dotPulse 2s ease-in-out infinite;
}
@keyframes dotPulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.4; }
}
.conn-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--success);
}
.sensor-row {
  margin-left: auto;
  display: flex;
  gap: 24rpx;
}
.sensor-val {
  font-size: 24rpx;
  color: var(--text-dim);
}

/* ===== disconnected ===== */
.disconnected {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.discon-card {
  width: 100%;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 56rpx 40rpx;
  text-align: center;
  border: 2rpx dashed var(--on-color);
}
.discon-icon { font-size: 72rpx; display: block; margin-bottom: 20rpx; }
.discon-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  display: block;
  margin-bottom: 10rpx;
}
.discon-desc {
  font-size: 24rpx;
  color: var(--text-dim);
  display: block;
  margin-bottom: 28rpx;
}
.reconnect-btn {
  width: 280rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: var(--primary);
  color: var(--white);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 38rpx;
  border: none;
}
.reconnect-btn-press { opacity: 0.85; }

/* ===== section ===== */
.section {
  margin-bottom: 28rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.section-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-dim);
  letter-spacing: 3rpx;
  text-transform: uppercase;
  display: block;
  margin-bottom: 14rpx;
}
.section-head .section-title { margin-bottom: 0; }
.section-val {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 600;
}

/* ===== mode rows ===== */
.mode-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.mode-row-center {
  justify-content: center;
  padding: 0 12rpx;
}
.mode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1;
  background: var(--bg-card);
  border-radius: var(--radius);
  border: 2rpx solid transparent;
}
.item-4 { width: calc(25% - 9rpx); }
.item-3 { width: calc(33.33% - 8rpx); max-width: 200rpx; }
.mode-item.active {
  border-color: var(--primary);
  box-shadow: 0 0 20rpx var(--primary-glow);
}
.mode-item-press { background: var(--bg-card-hover); }
.mode-emoji {
  font-size: 46rpx;
  margin-bottom: 8rpx;
}
.mode-label {
  font-size: 22rpx;
  color: var(--text-dim);
  font-weight: 500;
}

/* ===== slider ===== */
.slider-wrap {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx 18rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
}
.slider-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 4rpx;
}
.slider-label {
  font-size: 18rpx;
  color: var(--text-muted);
}

/* ===== color row ===== */
.color-row {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}
.color-dot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  position: relative;
}
.color-dot.active {
  border-color: var(--white);
  box-shadow: 0 0 28rpx rgba(255,255,255,0.3);
  transform: scale(1.12);
}
.color-press { transform: scale(0.92); }
.color-inner {
  font-size: 24rpx;
  font-weight: 700;
  color: #333;
}
.color-0 { background: #ffffff; }
.color-1 { background: #00ffff; }
.color-2 { background: #ffff00; }
.color-3 { background: #ff00ff; }
.color-4 { background: #4488ff; }
.color-5 { background: #ff4444; }
.color-6 { background: #44ff44; }

/* ===== study ===== */
.study-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  text-align: center;
  border: 1rpx solid rgba(255,255,255,0.05);
}
.study-icon {
  font-size: 52rpx;
  display: block;
  margin-bottom: 16rpx;
}
.study-time {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--primary);
  display: block;
  line-height: 1;
  margin-bottom: 4rpx;
}
.study-unit {
  font-size: 24rpx;
  color: var(--text-dim);
  display: block;
  margin-bottom: 14rpx;
}
.study-tip {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ===== alarm row ===== */
.alarm-row {
  display: flex;
  gap: 16rpx;
}
.alarm-set-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--primary);
  color: var(--white);
  font-size: 26rpx;
  font-weight: 600;
  border-radius: var(--radius);
  border: none;
}
.alarm-clear-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--bg-card);
  color: var(--danger);
  font-size: 26rpx;
  border: 2rpx solid var(--danger);
  border-radius: var(--radius);
}
.btn-press { opacity: 0.8; }

/* ===== alarm modal ===== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal {
  width: 600rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 40rpx 36rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
}
.modal-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 32rpx;
}
.modal-pickers {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.picker-box {
  width: 140rpx;
  height: 120rpx;
  background: var(--bg);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--on-color);
}
.picker-label {
  font-size: 20rpx;
  color: var(--text-dim);
  margin-bottom: 6rpx;
}
.picker-val {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--primary);
}
.picker-colon {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-muted);
}
.modal-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
}
.modal-btns {
  display: flex;
  gap: 16rpx;
}
.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: var(--radius);
  border: none;
}
.modal-cancel {
  background: var(--bg);
  color: var(--text-dim);
}
.modal-ok {
  background: var(--primary);
  color: var(--white);
  font-weight: 600;
}

/* ===== footer ===== */
.footer-btn {
  margin-top: 40rpx;
}
.discon-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  color: var(--text-muted);
  font-size: 26rpx;
  border: 1rpx solid var(--on-color);
  border-radius: var(--radius-lg);
}
.discon-btn-press {
  background: var(--error-bg);
  color: var(--danger);
  border-color: var(--danger);
}
