menu "SmartLamp Configuration"

    menu "Wi-Fi Settings"
        config SMARTLAMP_WIFI_SSID
            string "Wi-Fi SSID"
            default ""
            help
                Wi-Fi network name (SSID). Used for SNTP time sync
                and OTA firmware download.

        config SMARTLAMP_WIFI_PASSWORD
            string "Wi-Fi Password"
            default ""
            help
                Wi-Fi password.
    endmenu

    menu "OTA Settings"
        config SMARTLAMP_OTA_ENABLE
            bool "Enable OTA firmware upgrade"
            default y
            help
                Enable Over-The-Air firmware upgrade on boot.
                ESP32 will check for new firmware from configured
                URL after WiFi connects, download and flash if newer.

        config APP_PROJECT_VER
            string "Firmware version string"
            default "1.0.0"
            help
                Application version string used for OTA version comparison.
                Compared against the server version.txt content to decide
                whether to download a new firmware.

        config SMARTLAMP_OTA_FIRMWARE_URL
            string "OTA Firmware URL"
            default ""
            help
                HTTP URL to download the firmware .bin file, e.g.:
                http://192.168.1.100:8070/smartlamp.bin
                Uses HTTP (no TLS), must enable CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP
                in sdkconfig.defaults.

        config SMARTLAMP_OTA_VERSION_URL
            string "OTA Version Check URL"
            default ""
            help
                HTTP URL to check latest firmware version, e.g.:
                http://192.168.1.100:8070/version.txt
                The file should contain a version string like "1.0.1".
                If empty, OTA will download unconditionally (not recommended).
    endmenu

endmenu
