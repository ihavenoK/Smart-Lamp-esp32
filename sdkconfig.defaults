# GlowMate SmartLamp - ESP32 SDK Config Defaults
# ESP32-WROOM-32, ESP-IDF v5.x

# CPU & Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# FreeRTOS
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# WiFi
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# BLE (NimBLE, 内置 bt 组件)
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# LWIP (TCP sockets)
CONFIG_LWIP_MAX_SOCKETS=8

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Compiler
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Log level (reduce overhead)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# ====== OTA Firmware Upgrade ======
# Allow HTTP (no TLS certificate required, development convenience)
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
# App version embedded in firmware header — compared against server
CONFIG_APP_PROJECT_VER="1.0.0"
# Bootloader rollback support: if new OTA firmware fails to boot, roll back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# HTTP client (used by OTA to download firmware)
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
